{
  "name": "gemma-cli",
  "version": "1.0.0",
  "description": "A local AI agent powered by Google Gemma — runs fully offline",
  "bin": {
    "gemma": "./dist/bin/gemma.js"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/postbuild.mjs",
    "dev": "tsx watch bin/gemma.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'bin/**/*.ts'"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@inquirer/prompts": "^7.3.0",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "got": "^14.4.2",
    "ink": "^5.0.1",
    "marked": "^14.1.2",
    "marked-terminal": "^7.1.0",
    "node-llama-cpp": "^3.3.1",
    "ora": "^8.1.1",
    "react": "^18.3.1",
    "semver": "^7.6.3",
    "systeminformation": "^5.23.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/fs-extra": "^11.0.4",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.1",
    "@types/semver": "^7.5.8",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
